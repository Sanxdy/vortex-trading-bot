# ── Exchange ──────────────────────────────────────────────
# Binance API keys (spot + futures). Testnet recommended.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_TESTNET=true

# For futures bot, use .env.futures with separate testnet keys

# ── Trading Configuration ────────────────────────────────
# See config/config.yaml for all profiles
ACTIVE_PROFILE=trend_only                 # spot bot profile
TRADE_PAIRS=                              # leave empty to use config.yaml pairs

# ── Telegram ──────────────────────────────────────────────
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ── AI Provider — 9Router (required for AI trade veto) ───
# See README for 9Router setup guide
NINEROUTER_URL=http://9router:20128/v1    # Docker internal
NINEROUTER_KEY=                           # Generate from 9Router dashboard

# ── Legacy AI (optional, replaced by 9Router) ────────────
# DEEPSEEK_API_KEY=
# GROQ_API_KEY=

# ── On-chain data APIs (optional) ────────────────────────
SOLSCAN_API_KEY=
# ETHERSCAN_API_KEY=
# ARBISCAN_API_KEY=

# ── Redis ────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── TimescaleDB ───────────────────────────────────────────
TIMESCALE_DB_HOST=localhost
TIMESCALE_DB_PORT=5432
TIMESCALE_DB_NAME=vortex_trades
TIMESCALE_DB_USER=vortex
TIMESCALE_DB_PASSWORD=vortex_password

# ── Simulation Mode ──────────────────────────────────────
SIMULATED_BALANCE=250                     # allocated risk budget, not wallet
# SIM_RESET_ON_START=false
# SIM_SWEEP_ON_START=false

# ── Miscellaneous ────────────────────────────────────────
TIMEZONE=7                                # UTC offset for display
AUTO_PROFILE=                             # leave empty to disable
DASHBOARD_USER=admin
DASHBOARD_PASS=changeme
