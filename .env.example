# Exchange API Keys (Trading permissions only)
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_TESTNET=true

# Pairs to trade (comma-separated, empty = use all enabled in config.yaml)
TRADE_PAIRS=BTC,ETH,SOL,XRP,BNB

# Telegram Bot
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# DeepSeek API (required for fundamental/news/onchain analysis)
DEEPSEEK_API_KEY=

# Sharpe Terminal API (free — get your key at https://www.sharpe.ai/login)
# SHARPE_API_KEY=sk_live_your_56_character_key_here

# On-chain data APIs (optional — one per chain)
SOLSCAN_API_KEY=
# ETHERSCAN_API_KEY=      # ETH
# ARBISCAN_API_KEY=       # ARB
# BSCSCAN_API_KEY=        # BNB
# TRONSCAN_API_KEY=       # TRX

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# TimescaleDB
TIMESCALE_DB_HOST=localhost
TIMESCALE_DB_PORT=5432
TIMESCALE_DB_NAME=vortex_trades
TIMESCALE_DB_USER=vortex
TIMESCALE_DB_PASSWORD=vortex_password

# Simulation (optional — cap sizing/budget for testing without wiping state)
SIMULATED_BALANCE=
SIM_RESET_ON_START=false
SIM_RESET_ON_CHANGE=false
SIM_RESET_ON_DISABLE=false
SIM_SWEEP_ON_START=false

# Auto profile switching (optional)
AUTO_PROFILE=true

# Timezone offset from UTC (used for timestamp display in Telegram and dashboard)
TIMEZONE=7
