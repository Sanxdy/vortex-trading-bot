# Exchange API Keys (Trading permissions only)
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_TESTNET=true

# Pairs to trade (comma-separated, empty = use all enabled in config.yaml)
TRADE_PAIRS=BTC,ETH,SOL,XRP,BNB

# Telegram Bot
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# DeepSeek API (required for fundamental/news/onchain analysis)
DEEPSEEK_API_KEY=

# (News is fetched via free RSS feeds — CoinTelegraph, CoinDesk, Decrypt — no API key needed)

# On-chain data APIs (optional — one per chain)
SOLSCAN_API_KEY=
# ETHERSCAN_API_KEY=      # ETH
# ARBISCAN_API_KEY=       # ARB
# BSCSCAN_API_KEY=        # BNB
# TRONSCAN_API_KEY=       # TRX

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# TimescaleDB
TIMESCALE_DB_HOST=localhost
TIMESCALE_DB_PORT=5432
TIMESCALE_DB_NAME=vortex_trades
TIMESCALE_DB_USER=vortex
TIMESCALE_DB_PASSWORD=vortex_password

# Simulation (optional — override balance for testing)
SIMULATED_BALANCE=

# Timezone offset from UTC (used for timestamp display in Telegram and dashboard)
TIMEZONE=7
